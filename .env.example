# Public site URL used for metadata, sitemap, and canonical tags.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Temporary portfolio version comparison switch (Current | V2).
# Set to "true" for local / staging comparison. Leave unset or "false" in production.
# When false/absent: the switch does not render and its client module is not loaded.
NEXT_PUBLIC_ENABLE_PORTFOLIO_VERSION_SWITCH=true
